# Non-secret WebAPI settings (Spring relaxed binding: SECURITY_JWT_SECRET is
# security.jwt.secret). Secrets are NOT set here; see compose.yaml.

# Secrets: one file per property under /run/secrets/webapi
SPRING_CONFIG_IMPORT=configtree:/run/secrets/webapi/

# Application database (Postgres service on the internal network)
DATASOURCE_URL=jdbc:postgresql://postgres:5432/webapi
DATASOURCE_USERNAME=webapi
SPRING_FLYWAY_USER=webapi

# CDM source passwords are stored encrypted (upstream default: in clear, or
# DES when enabled). Losing secrets/jasypt-password means re-entering them.
JASYPT_ENCRYPTOR_ENABLED=true
JASYPT_ENCRYPTOR_ALGORITHM=PBEWITHSHA256AND256BITAES-CBC-BC

# Upstream defaults to anonymous access; everyone signs in through CHI auth.
SECURITY_ALLOWANONYMOUSACCESS=false
# Granted the admin role on sign-in.
SECURITY_ADMINLOGIN=iretonrt
# Atlas and WebAPI share chi-tools.uc.edu: no cross-origin requests.
SECURITY_CORS_ENABLED=false

# CHI Authentication's signed sso-assertion (added by chi-hermes's nginx)
SECURITY_AUTH_ASSERTION_ENABLED=true
SECURITY_AUTH_ASSERTION_JWKSETURI=https://chi-tools.uc.edu/auth/.well-known/jwks.json
SECURITY_AUTH_ASSERTION_ISSUER=https://chi-tools.uc.edu/auth/
SECURITY_AUTH_ASSERTION_AUDIENCE=chi-tools.uc.edu
SECURITY_AUTH_ASSERTION_PROVIDERNAME=CHI Sign-In
SECURITY_AUTH_ASSERTION_LOGOUTURL=https://chi-tools.uc.edu/auth/logout

# Heap sized from the container limit (mem_limit in compose.yaml)
JAVA_OPTS=-XX:MaxRAMPercentage=75
